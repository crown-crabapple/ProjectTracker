# ProjectTracker — copy to .env and edit. .env is gitignored and never committed.
#
# Nothing in this file has a default that reaches a real server: the app refuses
# to start rather than connect somewhere it was not told to.

PT_DB_HOST=127.0.0.1
PT_DB_PORT=3306
PT_DB_USER=projecttracker
PT_DB_PASSWORD=
PT_DB_NAME=projecttracker

# The web server. Bound to loopback unless PT_HOST says otherwise.
PT_PORT=4180
PT_HOST=127.0.0.1

# Where uploaded files land. One directory, content-addressed by sha256.
PT_FILES_DIR=./var/files

# The default login. db/migrate.js leaves one account behind that can sign in, so
# a migrated database is usable without seeding the demo portfolio. It is created
# only when nothing in the database can sign in, and never touches an account
# that already exists.
#
# PT_ADMIN_PASSWORD is the one to set if you want to choose the password. Leave it
# empty and migrate generates one and prints it once — there is no built-in
# default, because a shipped admin/admin is a credential in the source tree.
# PT_ADMIN_LOGIN=admin
# PT_ADMIN_NAME=Administrator
# PT_ADMIN_EMAIL=
# PT_ADMIN_PASSWORD=

# Signing secret for share links and session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PT_SECRET=

# Repository and integration credentials are read from the environment by the
# variable name each integration row records in `token_env`, so a credential is
# never stored in the database and never appears in a dump.
#
# The git deck reads these when it pulls. The variable NAME goes on the
# repository row (and must be upper case, which is also what makes a pasted
# token fail validation); the value stays here. A repository with no token_env is
# pulled anonymously, which works for a public repository at a much lower rate
# limit and is reported on the deck as ANONYMOUS.
#
#   GitHub   a fine-grained or classic PAT with `repo` (and `security_events`
#            if you want Dependabot alerts counted rather than reported as
#            unavailable).
#   GitLab   a personal access token with `read_api`.
#   Forgejo  a token with repository read. Set `api_base` on the repository row
#            too — there is no default host to guess for a self-hosted forge.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# FORGEJO_TOKEN=
