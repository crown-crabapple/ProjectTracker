{
  "name": "projecttracker",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio and project tracker over MariaDB, built to the SeedFall tracker's shape",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "type": "commonjs",
  "main": "src/http/server.js",
  "bin": {
    "pt": "src/cli/tracker.js"
  },
  "scripts": {
    "start": "node src/http/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "reset": "node db/migrate.js --force && node db/seed.js",
    "cli": "node src/cli/tracker.js",
    "mcp": "node src/mcp/server.js",
    "test": "node test/selftest.js"
  },
  "dependencies": {
    "mysql2": "^3.11.0"
  }
}
